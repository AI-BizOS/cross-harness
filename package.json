{
  "name": "@bizos-ai/troupe",
  "version": "0.1.0",
  "description": "Run Claude Code, Codex, OpenCode, Gemini CLI, Kimi and other coding agents side by side: one open cross-harness protocol, live sessions, agent-to-agent Q&A, approvals, isolated worktrees, goal gates and review-before-merge, in a TUI or a local web GUI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "troupe": "bin/troupe.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./protocol": "./src/protocol/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "spec/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "start": "node bin/troupe.js",
    "gui": "node bin/troupe.js gui"
  },
  "keywords": [
    "agents",
    "coding-agents",
    "acp",
    "mcp",
    "claude-code",
    "codex",
    "opencode",
    "gemini-cli",
    "multi-agent",
    "orchestration",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AI-BizOS/troupe.git"
  }
}
